[gd_resource type="Resource" script_class="DatingProfile" load_steps=4 format=3]

[ext_resource type="Script" path="res://core/resources/dating_profile.gd" id="1_profile"]
[ext_resource type="Texture2D" path="res://assets/textures/dating/oliver_photo.png" id="2_photo"]
[ext_resource type="Resource" path="res://data/outings/date_night.tres" id="3_outing"]

[resource]
script = ExtResource("1_profile")
id = &"oliver"
display_name = "Oliver"
age = 25
bio = "UX Designer & film nerd. Curating Letterboxd lists, attending indie film screenings. Believes good aesthetics improve everyday life."
photo = ExtResource("2_photo")
green_flags = Array[String](["Thoughtful date ideas", "Asks genuinely engaging questions", "Great aesthetic sense"])
red_flags = Array[String](["Talks through movies to explain the cinematography", "Subtly judges mainstream media"])
match_chance = 0.65
date_outing = ExtResource("3_outing")
tags = Array[String](["cinema", "design", "indie"])
