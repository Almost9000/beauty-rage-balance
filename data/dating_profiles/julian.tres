[gd_resource type="Resource" script_class="DatingProfile" load_steps=4 format=3]

[ext_resource type="Script" path="res://core/resources/dating_profile.gd" id="1_profile"]
[ext_resource type="Texture2D" path="res://assets/textures/dating/julian_photo.png" id="2_photo"]
[ext_resource type="Resource" path="res://data/outings/date_night.tres" id="3_outing"]

[resource]
script = ExtResource("1_profile")
id = &"julian"
display_name = "Julian"
age = 28
bio = "Architect & urban planner. Coffee enthusiast, cyclist, designing walkable spaces. Love museum dates and good conversation."
photo = ExtResource("2_photo")
green_flags = Array[String](["Great listener", "Texts back reliably", "Passionate about his work"])
red_flags = Array[String](["Subtle superiority complex about your taste", "Takes 40 minutes to order food"])
match_chance = 0.85
date_outing = ExtResource("3_outing")
tags = Array[String](["creative", "culture", "urban"])
