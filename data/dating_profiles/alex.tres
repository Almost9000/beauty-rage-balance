[gd_resource type="Resource" script_class="DatingProfile" load_steps=4 format=3]

[ext_resource type="Script" path="res://core/resources/dating_profile.gd" id="1_profile"]
[ext_resource type="Texture2D" path="res://assets/textures/dating/alex_photo.png" id="2_photo"]
[ext_resource type="Resource" path="res://data/outings/date_night.tres" id="3_outing"]

[resource]
script = ExtResource("1_profile")
id = &"alex"
display_name = "Alex"
age = 29
bio = "Independent bookstore clerk & musician. Spends too much on vinyl and second-hand paperbacks. Always down for late-night tea and talking about life."
photo = ExtResource("2_photo")
green_flags = Array[String](["Emotionally expressive", "Supports creative goals", "No games or mixed signals"])
red_flags = Array[String](["Broods when he loses an argument", "Always 15 minutes late"])
match_chance = 0.7
date_outing = ExtResource("3_outing")
tags = Array[String](["music", "books", "sensitive"])
