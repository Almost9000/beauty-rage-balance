[gd_resource type="Resource" script_class="DatingProfile" load_steps=4 format=3]

[ext_resource type="Script" path="res://core/resources/dating_profile.gd" id="1_profile"]
[ext_resource type="Texture2D" path="res://assets/textures/dating/sam_photo.png" id="2_photo"]
[ext_resource type="Resource" path="res://data/outings/date_night.tres" id="3_outing"]

[resource]
script = ExtResource("1_profile")
id = &"sam"
display_name = "Sam"
age = 27
bio = "Veterinary technician & plant dad. Living with two rescue cats and 14 houseplants. Low-key nights, board games, and thrift stores are my vibe."
photo = ExtResource("2_photo")
green_flags = Array[String](["Gentle with animals", "Patient and calm presence", "Remembers small details"])
red_flags = Array[String](["Conflict avoidant to a fault", "Puts his cats' opinions before yours"])
match_chance = 0.75
date_outing = ExtResource("3_outing")
tags = Array[String](["animals", "cozy", "introvert"])
