[gd_resource type="Resource" script_class="NarrativeEvent" load_steps=9 format=3]

[ext_resource type="Script" path="res://core/resources/narrative_event.gd" id="1_event"]
[ext_resource type="Script" path="res://core/resources/narrative_condition.gd" id="2_cond"]
[ext_resource type="Script" path="res://core/resources/narrative_choice.gd" id="3_choice"]
[ext_resource type="Script" path="res://core/resources/stat_modifier.gd" id="4_statmod"]

[sub_resource type="Resource" id="Cond_1"]
script = ExtResource("2_cond")
kind = 4
flag_name = &"work_boundary_set"
flag_min_value = 1

[sub_resource type="Resource" id="Mod_placate_sanity"]
script = ExtResource("4_statmod")
stat = 0
kind = 0
value = 5.0
source_id = &"narrative:follow_up_confrontation"
label = "Tension diffused"

[sub_resource type="Resource" id="Choice_placate"]
script = ExtResource("3_choice")
stance = 0
text = "Thank you, Dan. I appreciate the flexibility."
modifiers = Array[ExtResource("4_statmod")]([SubResource("Mod_placate_sanity")])
set_flags = {}

[sub_resource type="Resource" id="Mod_deflect_sanity"]
script = ExtResource("4_statmod")
stat = 0
kind = 0
value = 10.0
source_id = &"narrative:follow_up_confrontation"
label = "Smooth deflection"

[sub_resource type="Resource" id="Choice_deflect"]
script = ExtResource("3_choice")
stance = 1
text = "Sounds like a solid plan. See you in the office tomorrow morning."
modifiers = Array[ExtResource("4_statmod")]([SubResource("Mod_deflect_sanity")])
set_flags = {}

[sub_resource type="Resource" id="Mod_assert_rage"]
script = ExtResource("4_statmod")
stat = 3
kind = 0
value = -15.0
source_id = &"narrative:follow_up_confrontation"
label = "Vindicated boundaries"

[sub_resource type="Resource" id="Mod_assert_sanity"]
script = ExtResource("4_statmod")
stat = 0
kind = 0
value = 25.0
source_id = &"narrative:follow_up_confrontation"
label = "Respected autonomy"

[sub_resource type="Resource" id="Choice_assert"]
script = ExtResource("3_choice")
stance = 2
text = "Thank you for acknowledging that and respecting my boundary. See you tomorrow."
modifiers = Array[ExtResource("4_statmod")]([SubResource("Mod_assert_rage"), SubResource("Mod_assert_sanity")])
set_flags = {
"self_respect": 1,
"work_respect_established": 1
}

[resource]
script = ExtResource("1_event")
id = &"follow_up_confrontation"
conditions = Array[ExtResource("2_cond")]([SubResource("Cond_1")])
once = true
priority = 25
channel = &"PHONE_CALL"
speaker = "Supervisor Dan"
lines = Array[String]([
"...Look, you were right earlier. It was unfair of me to call on your day off instead of managing the client's expectations myself.",
"I spoke to the account lead and pushed the review to tomorrow morning so we can look at the deck together during normal hours."
])
choices = Array[ExtResource("3_choice")]([SubResource("Choice_placate"), SubResource("Choice_deflect"), SubResource("Choice_assert")])
