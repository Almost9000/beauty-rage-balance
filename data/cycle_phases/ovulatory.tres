[gd_resource type="Resource" script_class="CyclePhaseData" load_steps=5 format=3]

[ext_resource type="Script" path="res://core/resources/cycle_phase_data.gd" id="1_phase"]
[ext_resource type="Script" path="res://core/resources/stat_modifier.gd" id="2_mod"]

[sub_resource type="Resource" id="Resource_mod_sanity"]
script = ExtResource("2_mod")
stat = 0
kind = 1
value = 0.75
source_id = &"cycle"
duration_min = -1
label = "Confidence boost"

[sub_resource type="Resource" id="Resource_mod_health"]
script = ExtResource("2_mod")
stat = 1
kind = 1
value = 0.5
source_id = &"cycle"
duration_min = -1
label = "Peak stamina"

; Placeholder values: to balance at M1 audit
[resource]
script = ExtResource("1_phase")
phase = 2
display_name = "CYCLE_PHASE_OVULATORY"
default_days = 3
length_days = Vector2i(2, 4)
modifiers = Array[ExtResource("2_mod")]([SubResource("Resource_mod_sanity"), SubResource("Resource_mod_health")])
symptom_tags = Array[StringName]([&"peak_confidence", &"social_energy"])
narrative_tags = Array[StringName]([&"ovulatory", &"charismatic"])
description = "Ovulatory phase: peak confidence, heightened stamina, and magnetic social presence."
