[gd_scene load_steps=4 format=3]

[ext_resource type="Theme" path="res://ui/theme/brb_theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://features/prep/prep_checklist_ui.gd" id="2_script"]
[ext_resource type="PackedScene" path="res://ui/widgets/countdown_label.tscn" id="3_countdown"]

[node name="PrepChecklistUI" type="PanelContainer"]
custom_minimum_size = Vector2(300, 0)
offset_right = 300.0
offset_bottom = 120.0
theme = ExtResource("1_theme")
script = ExtResource("2_script")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="TitleLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.96, 0.98, 1)
text = "OUTING PREP"
horizontal_alignment = 1

[node name="CountdownHBox" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="PrefixLabel" type="Label" parent="VBox/CountdownHBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.78, 0.85, 1)
text = "Departing in:"

[node name="CountdownLabel" parent="VBox/CountdownHBox" instance=ExtResource("3_countdown")]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.98, 0.75, 0.14, 1)
text = "00:00"
horizontal_alignment = 2

[node name="HSeparator" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="ChecklistVBox" type="VBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 4
